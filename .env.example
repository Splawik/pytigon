# Copy to `.env` and fill in locally. Never commit the real file.
#
# The bootstrap administrator `auto` / `anawa` is a documented default, not a
# secret. A local desktop installation uses it transparently; a production web
# server warns loudly until the password is changed
# (see pytigon/schserw/schsys/default_admin.py).

SECRET_KEY=
DEBUG=

# Bootstrap administrator (defaults shown; change the password in production)
# AUTOUSERNAME=auto
# AUTOPASSWORD=anawa

# Refuse to start in production while the bootstrap password is unchanged
# PYTIGON_STRICT_DEFAULT_ADMIN=1

# Applications whose forms require a staff user
# STAFF_ONLY_APPS=schinstall,schbuilder
