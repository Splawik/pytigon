% extends "schsys/app/login.html"

% load exfiltry
% load exsyntax
% load django_bootstrap5


%% login
    %% login_background
        div class=login_background
    div class=container login-container
        div class=row align-items-center
            div class=col
            div class=col-lg-6 col-xl-5
                div class=card text-bg-dark mb-3
                    form class=ajax-link DialogForm form-floating text-bg-warning,,,role=form,,,action={{base_path}}schsys/force_auto_password_change/,,,method=post,,,name=change_password,,,data-region=page-content
                        div class=card-header
                            {{prj_title|upper}}
                        div class=card-body
                            <div class="move-element {% block dialog_type %} modal-lg v-autosize{% endblock %}" data-position="^.plug/.modal-dialog:class"></div>
                            <meta name="RETURN" content="$$RETURN_RELOAD" />
                            {{ form.errors }}
                                {% csrf_token %}
                                
                                p class=text-xl-center..._(Change password for user 'auto' – change mandatory).

                                p class=text-xl-center
                                    i class=fa fa-lock fa-5x

                                %if form
                                    % vert_form:

                        div class=card-footer        
                            button type=submit,,,class=btn btn-lg btn-dark w-100
                                _(Change password)
            div class=col
