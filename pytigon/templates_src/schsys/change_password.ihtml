% extends "page.html"

% load exfiltry
% load exsyntax
% load django_bootstrap5

%% body
    <div class="move-element {% block dialog_type %}v-autosize{% endblock %}" data-position="^.plug/.modal-dialog:class"></div>
    <meta name="RETURN" content="$$RETURN_RELOAD" />
    {{ form.errors }}
    form class=ajax-link DialogForm form-floating,,,role=form,,,action={{base_path}}schsys/change_password/,,,method=post,,,name=change_password,,,data-region=page-content
        {% csrf_token %}
        
        p class=text-xl-center
            i class=fa fa-lock fa-5x

        %if form
            % form:
