% extends 'base0.html'

% load exfiltry
% load exsyntax

%% head_start
    % if fragment != 'content':
        script language=javascript,,,nonce={{ csp_nonce }}
            .window.BASE_PATH = '{{base_path}}';

%% css_links
    %% botstrap_css
        % if fragment != 'content':
            % if settings.BOOTSTRAP_TEMPLATE:
                {% css_link 'themes/'|add:settings.BOOTSTRAP_TEMPLATE|add:'/bootstrap.min.css' %}
            % else:
                {% css_link 'bootstrap/css/bootstrap.min.css' %}

%% body
    %% content
   
    % if fragment != 'content':
        {% jscript_link 'pytigon_js/py_runtime.min.js' %}
        {% jscript_link 'pytigon-lib-min.js' %}
        {% module_link 'pytigon_js/pytigon.min.js' %}
